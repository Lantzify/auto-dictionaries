<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<StaticWebAssetBasePath>App_Plugins/AutoDictionaries</StaticWebAssetBasePath>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>CS8603</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DeepL.net" Version="1.9.0" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="17.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<PackageId>AutoDictionaries</PackageId>
		<Version>17.0.0</Version>
		<Title>Auto dictionaries</Title>
		<Authors>Lantzify</Authors>
		<PackageIcon>logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Lantzify/auto-dictionaries</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Lantzify/auto-dictionaries</RepositoryUrl>
		<Description>Auto Dictionaries is an Umbraco package made to automate the process of replacing static content in templates and partial views with dictionary items. With built-in translation support, it streamlines the localization workflow for multilingual Umbraco websites</Description>
		<Summary>Auto Dictionaries is an Umbraco package made to automate the process of replacing static content in templates and partial views with dictionary items. With built-in translation support, it streamlines the localization workflow for multilingual Umbraco websites</Summary>
		<PackageTags>umbraco dictionaries package umbraco-marketplace</PackageTags>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageReadmeFile>umbraco-marketplace-readme.md</PackageReadmeFile>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<ContentTargetFolders>content</ContentTargetFolders>

		<PackageOutputPath>build/Release</PackageOutputPath>

	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\umbraco-marketplace-readme.md" Pack="true" PackagePath="\" />
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

	<!-- Auto-generate schema file before packing -->
		<Target Name="GenerateSchema" BeforeTargets="BeforeBuild">
			<Message Text="Generating AutoDictionaries schema file..." Importance="high" />
			<Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)\..\AutoDictionaries.SchemaGenerator\AutoDictionaries.SchemaGenerator.csproj&quot; -- -o &quot;$(MSBuildThisFileDirectory)appsettings-schema.auto-dictionaries.json&quot;" />
		</Target>
		<ItemGroup>
			<None Include="$(MSBuildThisFileDirectory)appsettings-schema.auto-dictionaries.json">
				<Pack>True</Pack>
				<PackagePath>content</PackagePath>
			</None>
		</ItemGroup>

		<ItemGroup>
		<None Include="buildTransitive\**\*.*">
			<Pack>True</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</None>
	</ItemGroup>

</Project>
